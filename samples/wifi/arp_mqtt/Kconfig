source "Kconfig.zephyr"

menu "ARP MQTT Wi-Fi client"

config ARP_MQTT_BROKER_HOSTNAME
	string "MQTT broker hostname or IP address"
	default "192.168.29.133"
	help
	  Broker IPv4 address, IPv6 address, or hostname.
	  IPv6 literals use standard notation without brackets, for example
	  2001:db8::1. Plain TCP only (not TLS).

config ARP_MQTT_BROKER_PORT
	int "MQTT broker TCP port"
	default 1883
	range 1 65535

config ARP_MQTT_BROKER_PREFER_IPV6
	bool "Prefer IPv6 when resolving broker hostname"
	default n
	depends on NET_IPV6
	help
	  When both A and AAAA DNS records exist, connect to the IPv6 address.
	  Literal IPv4/IPv6 strings in ARP_MQTT_BROKER_HOSTNAME are always honored.

config ARP_MQTT_SUB_TOPIC
	string "MQTT subscribe topic filter"
	default "actuator"
	help
	  MQTT topic filter for incoming messages (uses the # wildcard, e.g.
	  actuator).

config ARP_MQTT_PUB_TOPIC_PREFIX
	string "MQTT publish topic prefix"
	default ""
	help
	  Shell mqtt_pub <topic> publishes to <prefix><topic>.

config ARP_MQTT_APP_BUFFER_SIZE
	int "MQTT library RX/TX buffer size (bytes)"
	default 1024
	range 256 4096

config ARP_MQTT_PERIODIC_PUB
	bool "Autonomous periodic MQTT publish (RTT report)"
	default y
	help
	  Run a background thread that, while the MQTT session is up,
	  periodically pings the broker and publishes the round-trip delays
	  to the nrf/rtt topic. Disable to stop all autonomous publishing;
	  the shell mqtt_pub command remains available.

config ARP_MQTT_RTT_PERIOD_SECONDS
	int "Interval between periodic broker RTT reports (seconds)"
	depends on ARP_MQTT_PERIODIC_PUB
	default 10
	range 1 86400
	help
	  How often the sample pings the MQTT broker and publishes the
	  comma-separated round-trip delays (for example "5ms,102ms,4ms",
	  or "Nan" for a failed ping) to the nrf/rtt topic.

config ARP_MQTT_WIFI_LISTEN_INTERVAL
	bool "Configure Wi-Fi power-save listen interval"
	default n
	help
	  Once the network connection is up, set the Wi-Fi power-save wakeup
	  mode to listen interval and program the listen interval value
	  (in beacon intervals) given by ARP_MQTT_WIFI_LISTEN_INTERVAL_VALUE.

config ARP_MQTT_WIFI_LISTEN_INTERVAL_VALUE
	int "Wi-Fi listen interval (beacon intervals)"
	depends on ARP_MQTT_WIFI_LISTEN_INTERVAL
	default 10
	range 0 65535
	help
	  Number of beacon intervals between station wake-ups when the
	  listen-interval based power-save wakeup mode is used.

endmenu
